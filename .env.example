# Vireo environment variables (copy to .env, fill in real values)
# Generated by audit on 2026-06-04

# ============== CORE SECRETS ==============

# JWT signing secret — required for production, generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VIREO_JWT_SECRET=change-me-to-random-32-bytes

# ============== POSTGRES ==============

POSTGRES_USER=vireo
POSTGRES_PASSWORD=vireo_dev_only
POSTGRES_DB=vireo
# In-host: localhost; in docker: postgres (service name)
VIREO_STORAGE_URL=postgresql://vireo:vireo_dev_only@localhost:5432/vireo
VIREO_PG_URL=postgresql://vireo:vireo_dev_only@localhost:5432/vireo

# ============== REDIS ==============

VIREO_REDIS_URL=redis://localhost:6379
# Set to "postgres" to use Postgres-backed queue, "memory" for in-process
VIREO_QUEUE=memory

# ============== S3 / MinIO ==============

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=vireo
S3_ACCESS_KEY=vireo_minio
S3_SECRET_KEY=vireo_minio_dev_only
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000/vireo

# ============== LLM (OpenAI-compatible) ==============

# Optional — falls back to MockLLMClient if missing
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
# Custom endpoint (OpenRouter, Together, Ollama, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1

# ============== STRIPE (billing) ==============

# Mocked in dev — set real keys for production
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx

# ============== OAUTH PLATFORMS ==============

# YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/oauth/tiktok/callback

# Instagram (Meta Graph)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/oauth/instagram/callback

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/oauth/linkedin/callback

# X (Twitter)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/oauth/x/callback

# Public base used in oauth redirects
VIREO_OAUTH_REDIRECT_BASE=http://localhost:3000

# ============== MONITORING / ALERTING ==============

# Comma-separated list of webhook URLs (Slack incoming, Telegram bot, generic)
VIREO_WEBHOOK_URLS=
# slack | telegram | generic
VIREO_WEBHOOK_KIND=generic
# Polling interval for agent health checks
POLL_INTERVAL_MS=10000
# Where monitoring writes its JSONL log
VIREO_LOG_DIR=./logs

# ============== SERVICE PORTS ==============

PORT_STYLE=8001
PORT_EDITOR=8002
PORT_DISTRIBUTOR=8003
PORT_ANALYST=8004
PORT_AUTH=8005
PORT_BILLING=8006
PORT_VIDEO=8007
PORT_OAUTH=8008
PORT_INGEST=8009
PORT_MONITORING=8010
PORT_STUDIO=8011
PORT_DASHBOARD=3000
PORT_ORCHESTRATOR=8020

# ============== STORAGE / MEDIA ==============

# Where video agent writes media files
VIREO_MEDIA_DIR=./vireo_media
# Whisper cache directory and TTL
VIREO_WHISPER_CACHE_DIR=./vireo_media/whisper_cache
VIREO_WHISPER_CACHE_TTL_DAYS=30

# ============== AUTH / SESSION ==============

TOKEN_TTL_SEC=604800  # 7 days
NODE_ENV=development

# ============== VIREO STORE BACKEND ==============

# memory | postgres
VIREO_STORE=memory
